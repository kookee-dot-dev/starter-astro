# Required. A standard API key: your Kookee project → API keys → Create Key.
KOOKEE_API_KEY=

# The site's public address, used in canonical URLs, the sitemap and feeds.
# On Vercel it defaults to the production domain; locally to http://localhost:4321.
SITE_URL=

# Set to false to leave the roadmap page and its link in the header out of the build.
KOOKEE_ROADMAP=true

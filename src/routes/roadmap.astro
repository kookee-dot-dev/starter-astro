---
import { RoadmapBoard } from '../components/RoadmapBoard';
import Base from '../layouts/Base.astro';
import { API_KEY, getProject, getRoadmap } from '../lib/kookee';

// Added by the kookee-roadmap integration in astro.config.mjs unless KOOKEE_ROADMAP is "false".
const project = await getProject();
const roadmap = project ? await getRoadmap() : null;
---

<Base title="Roadmap">
  {
    roadmap && (
      <div class="site-container">
        <h1 class="site-title">Roadmap</h1>
        <p class="site-lead">
          What we are working on and what is under consideration. Vote for what you want most.
          {project?.portalUrl && (
            <>
              {' '}Share your own ideas on <a href={project.portalUrl}>our portal</a>.
            </>
          )}
        </p>
        <RoadmapBoard client:load columns={roadmap.columns} posts={roadmap.posts} apiKey={API_KEY!} />
      </div>
    )
  }
</Base>

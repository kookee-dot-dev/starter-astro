---
import { ChangelogList } from '@kookee/react/changelog';
import { Pagination } from '@kookee/react/entry';
import { listChangelog } from '../lib/kookee';
import { getPath } from '../lib/paths';

interface Props {
  page: number;
}

const { page } = Astro.props;
const entries = await listChangelog(page);
---

<div class="site-container site-narrow">
  <h1 class="site-title">Changelog</h1>
  <ChangelogList entries={entries.data} href={getPath} />
  <Pagination
    page={page}
    totalPages={entries.totalPages}
    href={(target: number) => (target === 1 ? '/changelog' : `/changelog/page/${target}`)}
    className="site-pagination"
  />
</div>

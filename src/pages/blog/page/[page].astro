---
import type { GetStaticPaths } from 'astro';
import BlogIndex from '../../../components/BlogIndex.astro';
import Base from '../../../layouts/Base.astro';
import { hasKey, listBlogPosts } from '../../../lib/kookee';

export const getStaticPaths = (async () => {
  if (!hasKey()) return [];
  const { totalPages } = await listBlogPosts(1);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}) satisfies GetStaticPaths;

const page = Number(Astro.params.page);
---

<Base title={`Blog, page ${page}`}><BlogIndex page={page} /></Base>
